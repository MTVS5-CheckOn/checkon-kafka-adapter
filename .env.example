# Kafka exposed by the CheckOn backend Compose stack to host processes.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
RISK_DETECTION_KAFKA_ENABLED=true
PROBLEM_GENERATION_KAFKA_ENABLED=false
PROBLEM_GENERATION_REQUEST_TOPIC=checkon.ai.problem-generation.requests.v1
PROBLEM_GENERATION_RESULT_TOPIC=checkon.ai.problem-generation.results.v1
PROBLEM_GENERATION_CONSUMER_GROUP=checkon-ai-adapter-problem-generation-v1
COUNSEL_DRAFT_KAFKA_ENABLED=false
COUNSEL_DRAFT_REQUESTED_TOPIC=checkon.counsel-draft.requested.v1
COUNSEL_DRAFT_COMPLETED_TOPIC=checkon.counsel-draft.completed.v1
COUNSEL_DRAFT_FAILED_TOPIC=checkon.counsel-draft.failed.v1
COUNSEL_DRAFT_CONSUMER_GROUP=checkon-ai-adapter-counsel-draft-v1

# Adapter-owned PostgreSQL. Use separate migration/runtime roles in production.
DB_URL=jdbc:postgresql://localhost:5432/checkon_kafka_adapter
DB_USERNAME=checkon_adapter
DB_PASSWORD=replace-me
FLYWAY_DB_URL=jdbc:postgresql://localhost:5432/checkon_kafka_adapter
FLYWAY_DB_USER=checkon_adapter_migrator
FLYWAY_DB_PASSWORD=replace-me

# Enable only after the AI team confirms the values below.
AI_RISK_DETECTION_ENABLED=false
AI_RISK_DETECTION_WORKER_ENABLED=false
AI_BASE_URL=http://localhost:8000
AI_DETECT_PATH=/v1/detect
AI_CONNECT_TIMEOUT=2s
AI_READ_TIMEOUT=65s
AI_RISK_DETECTION_LOCK_TIMEOUT=90s

# Problem Generation worker. It persists the child event and AI job id before polling.
AI_PROBLEM_GENERATION_WORKER_ENABLED=false
AI_PROBLEM_GENERATION_BASE_URL=http://localhost:8000
AI_PROBLEM_GENERATION_PATH=/v1/problems
AI_PROBLEM_GENERATION_AI_POLL_INTERVAL=2s
AI_PROBLEM_GENERATION_LOCK_TIMEOUT=30s
AI_PROBLEM_GENERATION_MAX_ATTEMPTS=5
AI_PROBLEM_GENERATION_LANGUAGE_CONCEPT_NODE=language.grammar.phonological_change
AI_PROBLEM_GENERATION_LANGUAGE_INFER_NODE=language.grammar.phonological_change

# Counsel draft worker (SUBMIT/POLL, like Problem Generation). POST only
# persists the request and returns immediately (AI-A 2026-08-20 POST-계약변경).
# Timeouts below are the AI team's 2026-08-20 deployment-measured recommendation:
# POST/GET share a 10s budget (cold tunnel round trip worst case 0.93s), and
# max-elapsed stays comfortably above the confirmed 450s worst-case per-job ceiling.
AI_COUNSEL_DRAFT_ENABLED=false
AI_COUNSEL_DRAFT_WORKER_ENABLED=false
AI_COUNSEL_DRAFT_BASE_URL=http://localhost:8000
AI_COUNSEL_DRAFT_PATH=/v1/counsel/drafts
AI_COUNSEL_DRAFT_CONNECT_TIMEOUT=2s
AI_COUNSEL_DRAFT_READ_TIMEOUT=10s
# refine is relayed synchronously (backend -> adapter -> AI) and keeps the old
# 480s budget -- it is still a real LLM call, unlike GET.
AI_COUNSEL_DRAFT_REFINE_READ_TIMEOUT=480s
AI_COUNSEL_DRAFT_AI_POLL_INTERVAL=2s
AI_COUNSEL_DRAFT_LOCK_TIMEOUT=10m
AI_COUNSEL_DRAFT_MAX_ELAPSED=8m
AI_COUNSEL_DRAFT_MAX_ATTEMPTS=3
